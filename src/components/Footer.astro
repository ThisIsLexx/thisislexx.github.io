---
import { SITE, SOCIAL, CONTACT } from '../config';

const year = new Date().getFullYear();
---

<footer class="pie">
  <div class="wrap pie__grid">
    <div>
      <p class="pie__brand">{SITE.name}</p>
      <p class="pie__role">{SITE.role} · {SITE.city}</p>
    </div>

    <nav class="pie__social" aria-label="Redes sociales">
      {
        SOCIAL.map((s) => (
          <a href={s.url} target="_blank" rel="noopener me">
            {s.label}
          </a>
        ))
      }
    </nav>

    <p class="pie__legal">
      © {year} {SITE.name}. Todos los derechos reservados.<br />
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
    </p>
  </div>

  <div class="pie__strip" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
</footer>

<style>
  .pie {
    background: var(--brand-ink);
    color: var(--brand-paper);
    padding-block-start: var(--space-5);
  }

  .pie__grid {
    display: grid;
    gap: var(--space-4);
    padding-block-end: var(--space-4);
  }

  .pie__brand { font-family: var(--font-display); font-size: var(--step-1); }
  .pie__role,
  .pie__legal {
    font-size: var(--step-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    opacity: 0.75;
  }

  .pie__social { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .pie__social a {
    font-size: var(--step-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    border-block-end: 2px solid var(--brand-red);
    padding-block-end: 2px;
  }

  .pie__social a:hover { border-block-end-color: var(--brand-magenta); }

  /* Tres franjas de color a pie de página */
  .pie__strip { display: flex; block-size: 1.25rem; }
  .pie__strip span { flex: 1; }
  .pie__strip span:nth-child(1) { background: var(--brand-red); }
  .pie__strip span:nth-child(2) { background: var(--brand-magenta); }
  .pie__strip span:nth-child(3) { background: var(--brand-blue); }

  @media (width >= 48rem) {
    .pie__grid { grid-template-columns: 1fr auto; align-items: end; }
    .pie__legal { grid-column: 1 / -1; }
  }
</style>
