---
/**
 * PROCESO — Cuatro pasos sobre una línea de tiempo.
 *
 * Una sola línea partida en cuatro tramos, uno por paso y en su
 * color. Al llegar a la sección la línea se dibuja de un trazo, tramo
 * por tramo, de izquierda a derecha (de arriba abajo en móvil); al
 * volver a subir se borra en sentido contrario, del 4 al 1. Sin
 * JavaScript, o con "reducir movimiento", la línea se ve ya completa.
 */
const pasos = [
  {
    titulo: 'El concepto',
    texto: 'Escuchamos tus maquetas y tus referencias. Salimos con alcance, fecha y un presupuesto acorde a tus necesidades.',
    color: 'red',
  },
  {
    titulo: 'Preproducción',
    texto: 'Definimos estructura, tonalidad y sonido antes de grabar. Aquí es donde se ahorran las revisiones.',
    color: 'blue',
  },
  {
    titulo: 'Estudio',
    texto: 'Grabación y producción, presencial o remota. Recibes avances conforme al avance del proyecto.',
    color: 'magenta',
  },
  {
    titulo: 'Entrega',
    texto: 'Mezcla, mastering, stems y versiones dependiendo el paquete. Todo en una carpeta ordenada y lista para tu distribuidora.',
    color: 'ink',
  },
];
---

<section class="section proceso" id="proceso">
  <div class="wrap">
    <h2 class="reveal">Cuatro pasos,<br />cero sorpresas</h2>

    <ol class="linea" role="list" data-linea>
      {
        pasos.map((p, i) => (
          <li class:list={['paso', `paso--${p.color}`]} style={`--i: ${i}; --j: ${pasos.length - 1 - i}`}>
            <span class="paso__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  /* Una sola señal para toda la línea: se marca cuando su borde de
     arriba pasa del 55% de la pantalla y se desmarca si se vuelve a
     subir. Lo que queda por encima de la pantalla cuenta como
     alcanzado. El orden de los tramos lo pone el CSS. */
  const linea = document.querySelector<HTMLElement>('[data-linea]');

  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (linea && !quieto && 'IntersectionObserver' in window) {
    linea.classList.add('linea--viva');

    const observador = new IntersectionObserver(
      ([e]) => {
        const pasado = e.isIntersecting || e.boundingClientRect.top < 0;
        linea.classList.toggle('alcanzada', pasado);
      },
      { rootMargin: '0px 0px -45% 0px', threshold: 0 }
    );

    observador.observe(linea);
  }
</script>

<style>
  .proceso { background: var(--brand-paper-dim); }

  .linea {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-5);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  .paso--red { --paso-c: var(--brand-red); }
  .paso--blue { --paso-c: var(--brand-blue); }
  .paso--magenta { --paso-c: var(--brand-magenta); }
  .paso--ink { --paso-c: var(--brand-ink); }

  /* El tramo: una raya fina de tinta (::before) y, encima, el relleno
     grueso en el color del paso (::after). En móvil la línea corre en
     vertical por la izquierda; en ancho, en horizontal por arriba. */
  .paso {
    position: relative;
    padding-inline-start: var(--space-4);
  }

  .paso::before,
  .paso::after {
    content: '';
    position: absolute;
    inset-block: 0 calc(var(--space-4) * -1);
    inset-inline-start: 0;
  }

  .paso:last-child::before,
  .paso:last-child::after { inset-block-end: 0; }

  .paso::before {
    inline-size: var(--border-w);
    inset-inline-start: calc((var(--border-w-thick) - var(--border-w)) / 2);
    background: var(--brand-ink);
    opacity: 0.25;
  }

  /* Un trazo continuo: cada tramo arranca justo cuando acaba el
     anterior, a velocidad constante, y solo el primero acelera y el
     último frena. Al dibujarse el orden es 1→4 (--i); al borrarse,
     4→1 (--j), así nunca se vacía el principio de la línea antes que
     el final. */
  .paso {
    --tramo: 320ms;
    --curva: linear;
  }

  .paso::after {
    inline-size: var(--border-w-thick);
    background: var(--paso-c);
    transform-origin: top;
    transition: transform var(--tramo) var(--curva) calc(var(--j) * var(--tramo));
  }

  .linea--viva.alcanzada .paso::after {
    transition-delay: calc(var(--i) * var(--tramo));
  }

  .linea--viva.alcanzada .paso:first-child,
  .linea--viva:not(.alcanzada) .paso:last-child { --curva: cubic-bezier(0.5, 0, 1, 1); }

  .linea--viva.alcanzada .paso:last-child,
  .linea--viva:not(.alcanzada) .paso:first-child { --curva: cubic-bezier(0, 0, 0.3, 1); }

  .linea--viva:not(.alcanzada) .paso::after { transform: scaleY(0); }

  .paso__n {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 0.9;
    color: var(--paso-c);
    font-variant-numeric: tabular-nums;
    /* El número se apaga junto con su tramo al borrarse la línea… */
    transition: color 300ms ease calc(var(--j) * var(--tramo));
  }

  /* …y se enciende cuando su tramo ya va casi completo. */
  .linea--viva.alcanzada .paso__n {
    transition-delay: calc(var(--i) * var(--tramo) + var(--tramo) * 0.6);
  }

  /* Hasta que el paso no se alcanza, su número espera en tinta suave:
     así se lee cuál viene después. */
  .linea--viva:not(.alcanzada) .paso__n { color: var(--color-muted); }

  .paso h3 {
    margin-block: var(--space-2);
    font-size: var(--step-card);
  }

  .paso p { font-size: var(--step-sm); color: var(--color-muted); }

  @media (width >= 55rem) {
    .linea {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
    }

    .paso {
      padding-inline: 0 var(--space-4);
      padding-block-start: var(--space-4);
    }

    .paso::before,
    .paso::after {
      inset-block: 0 auto;
      inset-inline: 0;
    }

    .paso::before {
      inline-size: auto;
      block-size: var(--border-w);
      inset-block-start: calc((var(--border-w-thick) - var(--border-w)) / 2);
    }

    .paso::after {
      inline-size: auto;
      block-size: var(--border-w-thick);
      transform-origin: left;
    }

    .linea--viva:not(.alcanzada) .paso::after { transform: scaleX(0); }
  }
</style>
