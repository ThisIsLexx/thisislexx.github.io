---
const pasos = [
  {
    titulo: 'El concepto',
    texto: 'Escuchamos tus maquetas y tus referencias. Salimos con alcance, fecha y un presupuesto acorde a tus necesidades.',
    color: 'red',
  },
  {
    titulo: 'Preproducción',
    texto: 'Definimos estructura, tonalidad y sonido antes de grabar. Aquí es donde se ahorran las revisiones.',
    color: 'blue',
  },
  {
    titulo: 'Estudio',
    texto: 'Grabación y producción, presencial o remota. Recibes avances conforme al avance del proyecto.',
    color: 'magenta',
  },
  {
    titulo: 'Entrega',
    texto: 'Mezcla, mastering, stems y versiones dependiendo el paquete. Todo en una carpeta ordenada y lista para tu distribuidora.',
    color: 'ink',
  },
];

interface Props {
  /** Número de sección; lo calcula index.astro según cuáles se pintan */
  n?: string;
}

const { n = '05' } = Astro.props;
---

<section class="section" id="proceso">
  <div class="wrap">
    <p class="eyebrow eyebrow--tri reveal">{n} / Proceso</p>
    <h2 class="reveal">Cuatro pasos,<br />cero sorpresas</h2>

    <ol class="steps" role="list">
      {
        pasos.map((p, i) => (
          <li class:list={['step', `step--${p.color}`, 'reveal']} data-foco>
            <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-5);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-cards);
  }

  .step {
    padding: var(--space-4) var(--space-3);
    border: var(--border-w) solid var(--brand-ink);
    position: relative;
    transition:
      background-color var(--transition-lento),
      color var(--transition-lento),
      box-shadow var(--transition-lento);
  }

  .step__n { transition: color var(--transition-lento), transform 340ms cubic-bezier(0.34, 1.3, 0.64, 1); }
  .step p { transition: color var(--transition-lento); }

  /* Efectos de realce. Se encienden con el ratón y, en pantallas sin
     ratón, con la clase .en-foco que pone el scroll (src/scripts/foco.ts):
     lo que pasa por el centro de la pantalla es lo que está vivo. */
  /* El paso se rellena con su propio color de franja */
  .step:is(:hover, .en-foco) {
    background: var(--step-c);
    color: var(--step-fg);
    box-shadow: var(--shadow-hard);
  }
  .step:is(:hover, .en-foco) .step__n { color: var(--step-fg); transform: translateY(-4px); }
  .step:is(:hover, .en-foco) p { color: var(--step-fg); }

  /* Franja de color de 8px en el borde superior de cada paso */
  .step::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 8px;
    background: var(--step-c);
  }

  .step--red { --step-c: var(--brand-red); --step-fg: var(--color-on-accent); }
  .step--blue { --step-c: var(--brand-blue); --step-fg: var(--color-on-accent); }
  .step--magenta { --step-c: var(--brand-magenta); --step-fg: var(--color-on-magenta); }
  .step--ink { --step-c: var(--brand-ink); --step-fg: var(--brand-paper); }

  .step__n {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--step-c);
    display: block;
    line-height: 1;
  }

  .step h3 {
    margin-block: var(--space-2) var(--space-2);
    font-size: var(--step-card);
  }
  .step p { font-size: var(--step-sm); color: var(--color-muted); }

  /* Dos columnas y no cuatro: el contenedor tope en 78rem, así que
     una fila de 4 deja solo ~204px útiles por tarjeta y cualquier
     palabra de 13 letras o más se parte. Con 2 sobra el ancho. */
  @media (width >= 34rem) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
