---
/**
 * PROCESO — Cuatro pasos sobre una línea de tiempo.
 *
 * Cada paso tiene su tramo de raya en su color. Al bajar por la
 * página, los tramos se rellenan en orden, de izquierda a derecha
 * (de arriba abajo en móvil): el recorrido del proyecto avanza con
 * el del visitante. Sin JavaScript, o con "reducir movimiento", la
 * línea se ve ya completa.
 */
const pasos = [
  {
    titulo: 'El concepto',
    texto: 'Escuchamos tus maquetas y tus referencias. Salimos con alcance, fecha y un presupuesto acorde a tus necesidades.',
    color: 'red',
  },
  {
    titulo: 'Preproducción',
    texto: 'Definimos estructura, tonalidad y sonido antes de grabar. Aquí es donde se ahorran las revisiones.',
    color: 'blue',
  },
  {
    titulo: 'Estudio',
    texto: 'Grabación y producción, presencial o remota. Recibes avances conforme al avance del proyecto.',
    color: 'magenta',
  },
  {
    titulo: 'Entrega',
    texto: 'Mezcla, mastering, stems y versiones dependiendo el paquete. Todo en una carpeta ordenada y lista para tu distribuidora.',
    color: 'ink',
  },
];
---

<section class="section proceso" id="proceso">
  <div class="wrap">
    <h2 class="reveal">Cuatro pasos,<br />cero sorpresas</h2>

    <ol class="linea" role="list" data-linea>
      {
        pasos.map((p, i) => (
          <li class:list={['paso', `paso--${p.color}`]} style={`--i: ${i}`}>
            <span class="paso__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  /* Marca como alcanzado cada paso cuyo borde de arriba ya pasó del
     55% de la pantalla, y lo desmarca si se vuelve a subir. Lo que
     queda por encima de la pantalla cuenta como alcanzado. */
  const pasos = document.querySelectorAll<HTMLElement>('[data-linea] > .paso');

  if (pasos.length && 'IntersectionObserver' in window) {
    document.querySelector('[data-linea]')?.classList.add('linea--viva');

    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          const pasado = e.isIntersecting || e.boundingClientRect.top < 0;
          e.target.classList.toggle('alcanzado', pasado);
        }
      },
      { rootMargin: '0px 0px -45% 0px', threshold: 0 }
    );

    for (const paso of pasos) observador.observe(paso);
  }
</script>

<style>
  .proceso { background: var(--brand-paper-dim); }

  .linea {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-5);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  .paso--red { --paso-c: var(--brand-red); }
  .paso--blue { --paso-c: var(--brand-blue); }
  .paso--magenta { --paso-c: var(--brand-magenta); }
  .paso--ink { --paso-c: var(--brand-ink); }

  /* El tramo: una raya fina de tinta (::before) y, encima, el relleno
     grueso en el color del paso (::after). En móvil la línea corre en
     vertical por la izquierda; en ancho, en horizontal por arriba. */
  .paso {
    position: relative;
    padding-inline-start: var(--space-4);
  }

  .paso::before,
  .paso::after {
    content: '';
    position: absolute;
    inset-block: 0 calc(var(--space-4) * -1);
    inset-inline-start: 0;
  }

  .paso:last-child::before,
  .paso:last-child::after { inset-block-end: 0; }

  .paso::before {
    inline-size: var(--border-w);
    inset-inline-start: calc((var(--border-w-thick) - var(--border-w)) / 2);
    background: var(--brand-ink);
    opacity: 0.25;
  }

  .paso::after {
    inline-size: var(--border-w-thick);
    background: var(--paso-c);
    transform-origin: top;
    /* Al ritmo del resto de la página: cada tramo tarda lo que una
       entrada de foto y el siguiente arranca antes de que acabe, así
       la línea se lee como un recorrido sin hacerse esperar. */
    transition: transform 700ms cubic-bezier(0.45, 0, 0.2, 1) calc(var(--i) * 220ms);
  }

  .linea--viva .paso:not(.alcanzado)::after { transform: scaleY(0); }

  .paso__n {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 0.9;
    color: var(--paso-c);
    font-variant-numeric: tabular-nums;
    transition: color 400ms ease calc(var(--i) * 220ms + 300ms);
  }

  /* Hasta que el paso no se alcanza, su número espera en tinta suave:
     así se lee cuál viene después. */
  .linea--viva .paso:not(.alcanzado) .paso__n { color: var(--color-muted); }

  .paso h3 {
    margin-block: var(--space-2);
    font-size: var(--step-card);
  }

  .paso p { font-size: var(--step-sm); color: var(--color-muted); }

  @media (width >= 55rem) {
    .linea {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
    }

    .paso {
      padding-inline: 0 var(--space-4);
      padding-block-start: var(--space-4);
    }

    .paso::before,
    .paso::after {
      inset-block: 0 auto;
      inset-inline: 0;
    }

    .paso::before {
      inline-size: auto;
      block-size: var(--border-w);
      inset-block-start: calc((var(--border-w-thick) - var(--border-w)) / 2);
    }

    .paso::after {
      inline-size: auto;
      block-size: var(--border-w-thick);
      transform-origin: left;
    }

    .linea--viva .paso:not(.alcanzado)::after { transform: scaleX(0); }
  }
</style>
