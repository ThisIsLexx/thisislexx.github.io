---
/**
 * ESTUDIO — Dónde se graba y se mezcla: bloques de foto grande +
 * texto, alternando el lado, y debajo las fotos de sesiones.
 *
 * Antes eran dos secciones (Estudio y Sesiones) que enseñaban lo
 * mismo, el estudio, con dos titulares distintos. Ahora es una:
 *   · src/content/estudio/  → un archivo = un bloque foto + texto
 *   · src/content/galeria/  → un archivo = una polaroid del muro de
 *                             sesiones (se recorta cuadrada)
 *
 * Lo que no trae imagen se descarta, y si no queda nada en ninguna
 * de las dos colecciones la sección entera no se pinta. Así los
 * archivos de ejemplo pueden vivir en el repositorio sin sacar un
 * hueco roto en la página.
 */
import { getCollection, render } from 'astro:content';
import Shape from './Shape.astro';
import Foto from './Foto.astro';

/** Giro de cada polaroid en el muro, en grados. Se repiten en orden:
    un patrón corto que no se note, y sin aleatorio para que la página
    salga igual en cada visita. */
const GIROS = [-3, 2.5, -1.5, 3, -2, 1.5, -2.5];

/** Color de la chincheta de cada polaroid, en el orden del logotipo */
const CHINCHETAS = ['red', 'blue', 'magenta'] as const;

const entradas = (await getCollection('estudio'))
  .filter((e) => e.data.imagen.trim() !== '')
  .sort((a, b) => a.data.orden - b.data.orden);

const bloques = await Promise.all(
  entradas.map(async (e) => ({ ...e, Body: (await render(e)).Content }))
);

const fotos = (await getCollection('galeria'))
  .filter((f) => f.data.imagen.trim() !== '')
  .sort((a, b) => a.data.orden - b.data.orden);
---

{
  (bloques.length > 0 || fotos.length > 0) && (
    <section class="section" id="estudio">
      <div class="wrap">
        <h2 class="reveal">Dónde<br />pasa todo</h2>

        {bloques.length > 0 && (
          <div class="bloques">
            {/* Cada bloque entra desde el borde donde vive su foto. */}
            {bloques.map((b, i) => (
              <article
                class:list={[
                  'bloque',
                  'reveal',
                  i % 2 === 1 ? 'reveal--der' : 'reveal--izq',
                  { 'bloque--invertido': i % 2 === 1 },
                ]}
                data-foco
              >
                <figure class="bloque__foto">
                  {/* Media columna en ancho (algo más de 600 px), todo el
                      ancho de la página en móvil. */}
                  <Foto
                    src={b.data.imagen}
                    alt={b.data.alt}
                    widths={[480, 720, 960, 1280]}
                    sizes="(min-width: 78rem) 640px, (min-width: 55rem) 52vw, 100vw"
                  />
                  <Shape
                    tipo={b.data.figura}
                    color={b.data.color}
                    size="min(22vw, 8rem)"
                    class="bloque__figura"
                  />
                </figure>

                <div class="bloque__texto">
                  <h3>{b.data.titulo}</h3>
                  <b.Body />
                </div>
              </article>
            ))}
          </div>
        )}

        {fotos.length > 0 && (
          <div class="sesiones">
            <h3 class="sesiones__titulo">Sesiones</h3>

            <ul class="muro" role="list">
              {fotos.map((f, i) => (
                <li
                  class="polaroid reveal reveal--zoom"
                  style={`--giro: ${GIROS[i % GIROS.length]}deg`}
                  data-foco
                >
                  <figure>
                    <span
                      class:list={['chincheta', `chincheta--${CHINCHETAS[i % CHINCHETAS.length]}`]}
                      aria-hidden="true"
                    />
                    {/* Polaroid pequeña: media columna en móvil, unos
                        200 px en ancho. */}
                    <Foto
                      src={f.data.imagen}
                      alt={f.data.alt}
                      widths={[240, 360, 480]}
                      sizes="(min-width: 42rem) 14rem, 45vw"
                      anchoRemoto={600}
                    />
                    {f.data.titulo && <figcaption>{f.data.titulo}</figcaption>}
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .bloques {
    display: grid;
    gap: var(--space-6);
    margin-block-start: var(--space-5);
  }

  .bloque {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
  }

  /* La foto: marco duro y sombra dura, como cualquier otra caja del
     sitio. En gris por defecto y a color al acercarse, que es el
     único momento de color de la sección. */
  .bloque__foto {
    position: relative;
    margin: 0;
    border: var(--border-w) solid var(--brand-ink);
    box-shadow: var(--shadow-hard);
    /* La figura decorativa se sale del marco a propósito */
    overflow: visible;
  }

  .bloque__foto img {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 420ms var(--ease-out);
  }

  /* Efectos de realce. Se encienden con el ratón y, en pantallas sin
     ratón, con la clase .en-foco que pone el scroll (src/scripts/foco.ts):
     lo que pasa por el centro de la pantalla es lo que está vivo. */
  .bloque:is(:hover, .en-foco) .bloque__foto img { filter: grayscale(0) contrast(1); }
  .bloque:is(:hover, .en-foco) :global(.bloque__figura) {
    transform: rotate(90deg) scale(1.1);
  }

  /* Figura Bauhaus solapando la esquina inferior izquierda */
  .bloque :global(.bloque__figura) {
    position: absolute;
    /* En estrecho el saliente se queda en --space-2: con --space-3
       (24 px) se comía el margen de la página (20 px) y la sección,
       que lleva overflow:hidden, cortaba la figura contra el borde. */
    inset-block-end: calc(var(--space-2) * -1);
    inset-inline-start: calc(var(--space-2) * -1);
    transition: transform 450ms var(--ease-out);
  }

  .bloque__texto h3 {
    font-size: var(--step-2);
    margin-block-end: var(--space-2);
  }

  .bloque__texto :global(p) {
    color: var(--color-muted);
    max-width: 46ch;
  }

  .bloque__texto :global(p + p) { margin-block-start: var(--space-2); }

  @media (width >= 55rem) {
    .bloque {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-5);
    }

    /* Bloque par: la foto salta a la derecha. Se mueve con order y no
       reordenando el HTML a propósito: así el orden de lectura es el
       mismo en todos los bloques (foto, título, texto) y solo cambia
       el lado visual. Alternar también el HTML haría que un lector de
       pantalla leyera unos bloques al revés que otros. */
    .bloque--invertido .bloque__foto { order: 2; }

    /* En el bloque invertido la figura cambia de esquina, o siempre
       apuntaría hacia fuera de la página. */
    /* Con sitio de sobra, el saliente vuelve a ser el grande.
       Esta regla va ANTES que la del bloque invertido a propósito:
       las dos tienen la misma especificidad, así que si fuera
       después le devolvería el inset-inline-start y la figura no
       cambiaría de esquina. */
    .bloque :global(.bloque__figura) {
      inset-block-end: calc(var(--space-3) * -1);
      inset-inline-start: calc(var(--space-3) * -1);
    }

    .bloque--invertido :global(.bloque__figura) {
      inset-inline-start: auto;
      inset-inline-end: calc(var(--space-3) * -1);
    }
  }

  /* ── Sesiones: muro de polaroids ───────────────────────────────
     Fotos pequeñas en marco de papel, cada una ligeramente girada y
     sujeta con una chincheta en uno de los colores de la marca, como
     las que se pegan en la pared del estudio. Gris por defecto y a
     color al acercarse, igual que las fotos de arriba; al pasar el
     ratón la polaroid se endereza y se adelanta.

     El giro va en la propiedad `rotate` y el realce en `scale`, no en
     `transform`: así la entrada al hacer scroll (que anima transform)
     no les quita el giro mientras dura. */
  .sesiones {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }

  .sesiones__titulo { font-size: var(--step-2); }

  .muro {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 8.5rem), 1fr));
    gap: var(--space-4) var(--space-3);
    margin: 0;
    padding: var(--space-2) 0 0;
    list-style: none;
  }

  .polaroid {
    rotate: var(--giro, 0deg);
    transition:
      rotate 320ms var(--ease-out),
      scale 320ms var(--ease-out);
  }

  .polaroid figure {
    position: relative;
    margin: 0;
    padding: 0.55rem 0.55rem 0;
    background: var(--paper-fixed);
    color: var(--ink-fixed);
    box-shadow: 0 12px 24px -10px rgb(0 0 0 / 0.7);
  }

  .polaroid img {
    display: block;
    inline-size: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 420ms var(--ease-out);
  }

  /* El pie va en el margen grueso de abajo, como escrito en la foto.
     Sin título, el margen se queda igual: así todas miden lo mismo. */
  .polaroid figcaption {
    min-block-size: 2.4rem;
    padding: 0.5rem 0.1rem 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-xs);
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .polaroid figure:not(:has(figcaption))::after {
    content: '';
    display: block;
    block-size: 2.4rem;
  }

  /* La chincheta: un círculo de color clavado arriba al centro */
  .chincheta {
    position: absolute;
    inset-block-start: -0.45rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    inline-size: 0.95rem;
    block-size: 0.95rem;
    border-radius: 50%;
    background: var(--chincheta-c);
    box-shadow: 0 2px 3px rgb(0 0 0 / 0.45);
  }

  .chincheta--red { --chincheta-c: var(--brand-red); }
  .chincheta--blue { --chincheta-c: var(--brand-blue); }
  .chincheta--magenta { --chincheta-c: var(--brand-magenta); }

  .polaroid:is(:hover, .en-foco) img { filter: grayscale(0) contrast(1); }

  @media (hover: hover) {
    .polaroid:hover {
      rotate: 0deg;
      scale: 1.06;
      position: relative;
      z-index: 1;
    }
  }

  @media (width >= 42rem) {
    .muro { grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); }
  }

  /* En ancho, el rótulo se queda en la primera columna y el muro
     ocupa el resto; si llegan más fotos, el muro crece hacia abajo
     mientras el rótulo lo acompaña pegado arriba. */
  @media (width >= 62rem) {
    .sesiones {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
      gap: var(--gap-cards);
      align-items: start;
    }

    .sesiones__titulo {
      position: sticky;
      inset-block-start: calc(4.5rem + var(--space-4));
    }
  }
</style>
