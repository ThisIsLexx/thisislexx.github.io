---
/**
 * ESTUDIO — Dónde se graba y se mezcla: bloques de foto grande +
 * texto, alternando el lado, y debajo las fotos de sesiones.
 *
 * Antes eran dos secciones (Estudio y Sesiones) que enseñaban lo
 * mismo, el estudio, con dos titulares distintos. Ahora es una:
 *   · src/content/estudio/  → un archivo = un bloque foto + texto
 *   · src/content/galeria/  → un archivo = una foto de sesión
 *
 * Lo que no trae imagen se descarta, y si no queda nada en ninguna
 * de las dos colecciones la sección entera no se pinta. Así los
 * archivos de ejemplo pueden vivir en el repositorio sin sacar un
 * hueco roto en la página.
 */
import { getCollection, render } from 'astro:content';
import Shape from './Shape.astro';
import { resolverImagen } from '../lib/imagen';

/** Proporción del hueco de cada foto de sesión, según su campo `formato` */
const RATIOS = {
  apaisado: '4 / 3',
  vertical: '3 / 4',
  cuadrado: '1 / 1',
  original: 'auto',
} as const;

const entradas = (await getCollection('estudio'))
  .filter((e) => e.data.imagen.trim() !== '')
  .sort((a, b) => a.data.orden - b.data.orden);

const bloques = await Promise.all(
  entradas.map(async (e) => ({ ...e, Body: (await render(e)).Content }))
);

const fotos = (await getCollection('galeria'))
  .filter((f) => f.data.imagen.trim() !== '')
  .sort((a, b) => a.data.orden - b.data.orden);
---

{
  (bloques.length > 0 || fotos.length > 0) && (
    <section class="section" id="estudio">
      <div class="wrap">
        <h2 class="reveal">Dónde<br />pasa todo</h2>

        {bloques.length > 0 && (
          <div class="bloques">
            {/* Cada bloque entra desde el borde donde vive su foto. */}
            {bloques.map((b, i) => (
              <article
                class:list={[
                  'bloque',
                  'reveal',
                  i % 2 === 1 ? 'reveal--der' : 'reveal--izq',
                  { 'bloque--invertido': i % 2 === 1 },
                ]}
                data-foco
              >
                <figure class="bloque__foto">
                  <img
                    src={resolverImagen(b.data.imagen)}
                    alt={b.data.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <Shape
                    tipo={b.data.figura}
                    color={b.data.color}
                    size="min(22vw, 8rem)"
                    class="bloque__figura"
                  />
                </figure>

                <div class="bloque__texto">
                  <h3>{b.data.titulo}</h3>
                  <b.Body />
                </div>
              </article>
            ))}
          </div>
        )}

        {fotos.length > 0 && (
          <div class="sesiones">
            <h3 class="sesiones__titulo">Sesiones</h3>

            <ul class="galeria" role="list">
              {fotos.map((f) => (
                <li
                  class:list={['foto', 'reveal', 'reveal--zoom', { 'foto--ancha': f.data.ancha }]}
                  style={`--foto-ratio: ${RATIOS[f.data.formato]}`}
                  data-foco
                >
                  <img
                    src={resolverImagen(f.data.imagen)}
                    alt={f.data.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  {f.data.titulo && <p class="foto__pie">{f.data.titulo}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .bloques {
    display: grid;
    gap: var(--space-6);
    margin-block-start: var(--space-5);
  }

  .bloque {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
  }

  /* La foto: marco duro y sombra dura, como cualquier otra caja del
     sitio. En gris por defecto y a color al acercarse, que es el
     único momento de color de la sección. */
  .bloque__foto {
    position: relative;
    margin: 0;
    border: var(--border-w) solid var(--brand-ink);
    box-shadow: var(--shadow-hard);
    /* La figura decorativa se sale del marco a propósito */
    overflow: visible;
  }

  .bloque__foto img {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 420ms var(--ease-out);
  }

  /* Efectos de realce. Se encienden con el ratón y, en pantallas sin
     ratón, con la clase .en-foco que pone el scroll (src/scripts/foco.ts):
     lo que pasa por el centro de la pantalla es lo que está vivo. */
  .bloque:is(:hover, .en-foco) .bloque__foto img { filter: grayscale(0) contrast(1); }
  .bloque:is(:hover, .en-foco) :global(.bloque__figura) {
    transform: rotate(90deg) scale(1.1);
  }

  /* Figura Bauhaus solapando la esquina inferior izquierda */
  .bloque :global(.bloque__figura) {
    position: absolute;
    /* En estrecho el saliente se queda en --space-2: con --space-3
       (24 px) se comía el margen de la página (20 px) y la sección,
       que lleva overflow:hidden, cortaba la figura contra el borde. */
    inset-block-end: calc(var(--space-2) * -1);
    inset-inline-start: calc(var(--space-2) * -1);
    transition: transform 450ms var(--ease-out);
  }

  .bloque__texto h3 {
    font-size: var(--step-2);
    margin-block-end: var(--space-2);
  }

  .bloque__texto :global(p) {
    color: var(--color-muted);
    max-width: 46ch;
  }

  .bloque__texto :global(p + p) { margin-block-start: var(--space-2); }

  @media (width >= 55rem) {
    .bloque {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-5);
    }

    /* Bloque par: la foto salta a la derecha. Se mueve con order y no
       reordenando el HTML a propósito: así el orden de lectura es el
       mismo en todos los bloques (foto, título, texto) y solo cambia
       el lado visual. Alternar también el HTML haría que un lector de
       pantalla leyera unos bloques al revés que otros. */
    .bloque--invertido .bloque__foto { order: 2; }

    /* En el bloque invertido la figura cambia de esquina, o siempre
       apuntaría hacia fuera de la página. */
    /* Con sitio de sobra, el saliente vuelve a ser el grande.
       Esta regla va ANTES que la del bloque invertido a propósito:
       las dos tienen la misma especificidad, así que si fuera
       después le devolvería el inset-inline-start y la figura no
       cambiaría de esquina. */
    .bloque :global(.bloque__figura) {
      inset-block-end: calc(var(--space-3) * -1);
      inset-inline-start: calc(var(--space-3) * -1);
    }

    .bloque--invertido :global(.bloque__figura) {
      inset-inline-start: auto;
      inset-inline-end: calc(var(--space-3) * -1);
    }
  }

  /* ── Sesiones ──────────────────────────────────────────────────
     Mismo tratamiento que las fotos de arriba: marco de tinta, gris
     por defecto y a color al acercarse. Sin veladura de color: dos
     tratamientos de foto en una misma sección se leen como dos
     sitios distintos. */
  .sesiones {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }

  .sesiones__titulo { font-size: var(--step-2); }

  .galeria {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-cards);
    /* Sin esto, una foto baja estira a sus vecinas de fila y les deja
       una franja de fondo debajo del marco. */
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foto {
    position: relative;
    margin: 0;
    border: var(--border-w) solid var(--brand-ink);
    overflow: hidden;
  }

  .foto img {
    display: block;
    inline-size: 100%;
    aspect-ratio: var(--foto-ratio, 4 / 3);
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 420ms var(--ease-out), transform 620ms var(--ease-out);
  }

  .foto:is(:hover, .en-foco) img { filter: grayscale(0) contrast(1); transform: scale(1.03); }

  /* Pie que sube desde abajo. Sin ratón se queda visible: la
     información no puede depender de un puntero que no existe. */
  .foto__pie {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    margin: 0;
    padding: var(--space-2);
    background: var(--brand-ink);
    color: var(--brand-paper);
    font-size: var(--step-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    max-width: none;
  }

  @media (hover: hover) {
    .foto__pie {
      translate: 0 100%;
      transition: translate var(--transition-lento);
    }

    .foto:hover .foto__pie { translate: 0 0; }
  }

  @media (width >= 42rem) {
    .galeria { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .foto--ancha { grid-column: 1 / -1; }
  }

  /* En ancho, el rótulo se queda en la primera columna y las fotos
     ocupan el resto: dos o tres fotos llenan la fila en vez de dejar
     un hueco a la derecha, y si llegan más, bajan en su columna
     mientras el rótulo las acompaña pegado arriba. */
  @media (width >= 62rem) {
    .sesiones {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
      gap: var(--gap-cards);
      align-items: start;
    }

    .sesiones__titulo {
      position: sticky;
      inset-block-start: calc(4.5rem + var(--space-4));
    }
  }
</style>
