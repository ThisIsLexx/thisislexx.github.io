---
/**
 * CONTACTO — Los dos caminos para escribir (WhatsApp y correo) y,
 * al lado, un retrato.
 *
 * El retrato es opcional: sale de CONTACT.retrato, en src/config.ts.
 * Mientras esté vacío —o mientras no exista el archivo— la columna
 * se queda con las figuras de colores de siempre, así que la sección
 * nunca aparece coja.
 *
 * Es el cierre de la página: un bloque de tinta con el titular casi
 * al tamaño de la portada y un solo color fuerte, el rojo del botón
 * de WhatsApp. El retrato lleva el tratamiento de
 * las fotos de Estudio: blanco y negro que recupera el color.
 */
import { CONTACT, waHref, mailHref } from '../config';
import { resolverImagen } from '../lib/imagen';
import Shape from './Shape.astro';


const retrato = resolverImagen(CONTACT.retrato, 900);
---

<section class="section contacto" id="contacto">
  <div class="wrap contacto__grid">
    <div>
      <h2 class="reveal">Cuéntame<br />tu proyecto</h2>
      <p class="lead">
        No hay formulario que llenar. Escríbeme por WhatsApp o correo con
        tu género, cuántas canciones son y para cuándo las necesitas.
        Te respondo con un presupuesto en menos de 48 horas.
      </p>

      <div class="contacto__cta">
        <a class="btn" href={waHref} target="_blank" rel="noopener">
          Abrir WhatsApp
        </a>
        <a class="btn btn--linea" href={mailHref}>Enviar correo</a>
      </div>

      <p class="contacto__mail">
        <a href={mailHref}>{CONTACT.email}</a>
      </p>
    </div>

    {
      retrato !== '' ? (
        <figure class="retrato reveal reveal--der" data-foco>
          <img src={retrato} alt={CONTACT.retratoAlt} loading="lazy" decoding="async" />
        </figure>
      ) : (
        <div class="contacto__art" aria-hidden="true">
          <Shape tipo="ring" color="magenta" size="min(30vw, 12rem)" />
          <Shape tipo="halfcircle" color="ink" size="min(34vw, 14rem)" />
          <Shape tipo="square" color="blue" size="min(18vw, 7rem)" />
        </div>
      )
    }
  </div>
</section>

<style>
  /* ── El cierre ─────────────────────────────────────────────────
     Bloque invertido, como Testimonios: tinta de fondo, papel para el
     texto, y el rojo reservado al botón de WhatsApp para que sea lo
     único que tira de la mirada. Los roles se reasignan aquí, igual
     que en la isla oscura del hero, para que líneas, sombras y foco
     salgan del papel y no se pierdan sobre la tinta. */
  .contacto {
    --brand-line: var(--brand-paper);
    --color-fg: var(--brand-paper);
    --color-focus: var(--brand-paper);
    --contacto-sombra: var(--brand-paper);

    background: var(--brand-ink);
    color: var(--brand-paper);
  }

  /* Casi al tamaño de la portada: un punto menos para que "tu
     proyecto" quepa en un renglón junto al retrato. */
  .contacto h2 { font-size: min(var(--step-4), 4.75rem, 12vw); }

  .contacto .lead { color: inherit; }

  .contacto__grid { display: grid; gap: var(--space-5); align-items: center; }

  .contacto__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
  }

  /* El botón principal es el rojo de siempre; aquí solo cambia su
     sombra, que sobre la tinta tiene que ser de papel para verse. */
  .contacto .btn { box-shadow: 4px 4px 0 var(--contacto-sombra); }
  .contacto .btn:hover { box-shadow: 0 0 0 transparent; }

  .btn--linea {
    --btn-bg: transparent;
    --btn-fg: var(--brand-paper);
    border-color: currentColor;
  }

  .contacto__mail {
    margin-block-start: var(--space-3);
    font-size: var(--step-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .contacto__art {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: center;
    gap: var(--space-3);
  }

  /* ── Retrato ───────────────────────────────────────────────────
     Vertical: es un retrato, y en la columna estrecha de la derecha
     una foto apaisada se quedaría en una tira. El tope de ancho
     evita que en pantallas grandes crezca más que el bloque de
     texto que tiene al lado.                                      */
  .retrato {
    position: relative;
    margin: 0;
    inline-size: 100%;
    max-inline-size: 26rem;
    justify-self: center;
    border: var(--border-w) solid currentColor;
    box-shadow: var(--shadow-hard);
    --shadow-hard: 8px 8px 0 var(--contacto-sombra);
    overflow: hidden;
  }

  .retrato img {
    display: block;
    inline-size: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 420ms var(--ease-out), transform 620ms var(--ease-out);
  }

  /* Con ratón lo enciende :hover; en táctil, la clase que pone el
     scroll (src/scripts/foco.ts) al pasar por el centro. */
  .retrato:is(:hover, .en-foco) img { filter: grayscale(0) contrast(1); transform: scale(1.03); }

  @media (width >= 55rem) {
    .contacto__grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr);
      gap: var(--space-6);
    }
  }
</style>
