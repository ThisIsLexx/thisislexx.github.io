---
/**
 * CRÉDITOS — Los artistas con los que he trabajado, en una línea fija,
 * como los créditos del reverso de un disco.
 *
 * Sustituye a la cinta que se deslizaba: una lista que no para de
 * moverse obliga a perseguir los nombres para leerlos, y es el recurso
 * que trae cualquier plantilla. Aquí los nombres están quietos y son
 * grandes; lo único que se mueve es la figura de quien señalas.
 *
 * Para cambiar los nombres, edita el array. Las figuras se reparten
 * solas en el orden del logotipo: cuadrado, círculo, triángulo.
 */
const artistas = ['CELG', 'OVAN', 'GustavoBK', 'Bleuss'];

const FIGURAS = ['cuadrado', 'circulo', 'triangulo'] as const;
---

<section class="creditos" aria-labelledby="creditos-titulo">
  <div class="wrap creditos__fila">
    <h2 class="creditos__titulo" id="creditos-titulo">Créditos</h2>

    <ul class="creditos__lista" role="list">
      {
        artistas.map((nombre, i) => (
          <li class="credito">
            <span class="credito__nombre">{nombre}</span>
            <i class:list={['figura', `figura--${FIGURAS[i % FIGURAS.length]}`]} aria-hidden="true" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .creditos {
    background: var(--brand-magenta);
    color: var(--color-on-magenta);
    border-block: var(--border-w-thick) solid var(--color-on-magenta);
    padding-block: var(--space-4);
  }

  .creditos__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }

  /* Va en <h2> para que la banda tenga nombre en el índice de la
     página, pero se viste de rótulo de créditos: pequeño y espaciado,
     sin competir con los nombres. */
  .creditos__titulo {
    font-family: var(--font-body);
    font-size: var(--step-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    line-height: 1;
  }

  .creditos__titulo::after { content: ' —'; }

  /* La lista se estira hasta el borde y reparte los nombres por toda
     la banda: como una línea de créditos, no como un renglón que se
     queda a medias. */
  .creditos__lista {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .credito {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .credito__nombre {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 0.9rem + 1.6vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    /* El padding está siempre, no solo al realzar: así el bloque de
       tinta aparece sin empujar a los vecinos. */
    padding-inline: 0.15em;
    transition:
      background-color var(--transition),
      color var(--transition);
  }

  /* Figuras: las tres del logotipo, en el color del texto. Hacen de
     separador entre nombres, así que la última sobra. */
  .figura {
    display: block;
    flex: none;
    inline-size: 1.1rem;
    block-size: 1.1rem;
    background: currentColor;
    transition: transform 450ms var(--ease-out);
  }

  .figura--circulo { border-radius: 50%; }

  .figura--triangulo {
    inline-size: 0;
    block-size: 0;
    background: none;
    border-inline: 0.65rem solid transparent;
    border-block-end: 1.1rem solid currentColor;
  }

  .credito:last-child .figura { display: none; }

  /* Con sitio para una sola línea, cada crédito ocupa su parte de la
     fila y deja su figura centrada en el hueco hasta el siguiente
     nombre. Por debajo, los nombres van a su ancho y parten de línea
     con su figura al lado, sin huecos estirados. */
  @media (width >= 60rem) {
    .credito { flex: 1 1 auto; }
    .credito:last-child { flex: none; }
    .figura { margin-inline: auto; }
  }

  /* Realce con ratón: el nombre se marca con el mismo bloque de tinta
     que "merece" en la portada, y su figura gira un cuarto de vuelta.
     Colores FIJOS: el bloque es oscuro en los dos temas, igual que el
     del hero. En táctil no hay realce; el nombre ya se lee entero. */
  @media (hover: hover) {
    .credito:hover .credito__nombre {
      background: var(--ink-fixed);
      color: var(--paper-fixed);
    }

    .credito:hover .figura { transform: rotate(90deg); }
  }
</style>
