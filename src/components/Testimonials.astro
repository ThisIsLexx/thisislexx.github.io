---
import { getCollection, render } from 'astro:content';
import { resolverImagen } from '../lib/imagen';

const entries = (await getCollection('testimonios')).sort(
  (a, b) => a.data.orden - b.data.orden
);

const testimonios = await Promise.all(
  entries.map(async (e) => ({ ...e, Body: (await render(e)).Content }))
);

interface Props {
  /** Número de sección; lo calcula index.astro según cuáles se pintan */
  n?: string;
}

const { n = '06' } = Astro.props;
---

<section class="section section--ink" id="testimonios">
  <div class="wrap">
    <p class="eyebrow reveal">{n} / Clientes</p>
    <h2 class="reveal">Lo que dicen<br />quienes ya grabaron</h2>

    <ul class="quotes" role="list">
      {
        testimonios.map(({ data, Body }, i) => (
          <li class:list={['quote', 'reveal', `quote--${i % 3}`]} data-foco>
            <span class="quote__mark" aria-hidden="true">"</span>
            <blockquote><Body /></blockquote>
            <footer class="quote__by">
              {data.foto && <img src={resolverImagen(data.foto, 112)} alt="" width="56" height="56" loading="lazy" />}
              <div>
                <p class="quote__name">{data.nombre}</p>
                <p class="quote__proj">
                  {data.rol ? `${data.rol} · ` : ''}{data.proyecto}
                </p>
              </div>
              <p class="quote__stars" aria-label={`${data.rating} de 5`}>
                <span aria-hidden="true">{'★'.repeat(data.rating)}</span>
              </p>
            </footer>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section--ink {
    background: var(--brand-ink);
    color: var(--brand-paper);
  }

  .section--ink :global(.eyebrow::before) { background: var(--brand-magenta); }

  .quotes {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-5);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-cards);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-3);
    background: var(--brand-paper);
    color: var(--brand-ink);
    border: var(--border-w) solid var(--brand-ink);
    box-shadow: var(--shadow-hard);
    position: relative;
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  /* Efectos de realce. Se encienden con el ratón y, en pantallas sin
     ratón, con la clase .en-foco que pone el scroll (src/scripts/foco.ts):
     lo que pasa por el centro de la pantalla es lo que está vivo. */
  .quote:is(:hover, .en-foco) {
    transform: translate(-5px, -5px);
    box-shadow: 13px 13px 0 var(--q-c);
  }

  .quote:is(:hover, .en-foco)::after { inline-size: 4rem; block-size: 4rem; border-radius: 0 0 0 4rem; }
  .quote:is(:hover, .en-foco) .quote__mark { transform: scale(1.25); }

  /* Cada tarjeta lleva un cuadrante de color distinto en la esquina */
  .quote::after {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    background: var(--q-c);
    border-radius: 0 0 0 2.5rem;
    transition: inline-size var(--transition), block-size var(--transition);
  }

  .quote--0 { --q-c: var(--brand-red); }
  .quote--1 { --q-c: var(--brand-blue); }
  .quote--2 { --q-c: var(--brand-magenta); }

  .quote__mark {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 0.5;
    color: var(--q-c);
    transform-origin: left center;
    transition: transform 350ms cubic-bezier(0.34, 1.3, 0.64, 1);
  }

  blockquote { font-size: var(--step-sm); }
  blockquote :global(p) { max-width: none; }

  .quote__by {
    margin-block-start: auto;
    padding-block-start: var(--space-2);
    border-block-start: var(--border-w) solid var(--brand-ink);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .quote__by img {
    inline-size: 56px;
    block-size: 56px;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--brand-ink);
    filter: grayscale(1);
  }

  .quote__name { font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
  .quote__proj { font-size: var(--step-xs); color: var(--color-muted); }
  .quote__stars { margin-inline-start: auto; color: var(--brand-red); letter-spacing: -0.05em; }

  @media (width >= 48rem) {
    .quotes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
