---
/**
 * TESTIMONIOS — Lo que dicen los artistas, a tamaño de titular.
 *
 * No son tarjetas: son citas grandes sobre el bloque de tinta, una
 * debajo de otra y desplazadas, como las frases sueltas de un
 * cuadernillo de disco. Cada una lleva su raya de color arriba y la
 * firma debajo. Un archivo en src/content/testimonios/ = una cita.
 */
import { getCollection, render } from 'astro:content';
import { resolverImagen } from '../lib/imagen';

const entries = (await getCollection('testimonios')).sort(
  (a, b) => a.data.orden - b.data.orden
);

const testimonios = await Promise.all(
  entries.map(async (e) => ({ ...e, Body: (await render(e)).Content }))
);
---

<section class="section section--ink" id="testimonios">
  <div class="wrap">
    <h2 class="reveal">Lo que dicen<br />quienes ya grabaron</h2>

    <ul class="citas" role="list">
      {
        testimonios.map(({ data, Body }, i) => (
          <li class:list={['cita', `cita--${i % 3}`]}>
            <figure>
              <blockquote>
                <Body />
              </blockquote>
              <figcaption class="cita__firma">
                {data.foto && (
                  <img src={resolverImagen(data.foto, 112)} alt="" width="56" height="56" loading="lazy" />
                )}
                <span>
                  <span class="cita__nombre">{data.nombre}</span>
                  <span class="cita__proyecto">
                    {data.rol ? `${data.rol} · ` : ''}{data.proyecto}
                  </span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section--ink {
    background: var(--brand-ink);
    color: var(--brand-paper);
    /* El texto secundario se tiñe del propio fondo invertido, no de
       un gris: sobre tinta el --color-muted de la página no contrasta. */
    --cita-suave: color-mix(in srgb, var(--brand-paper) 72%, var(--brand-ink));
  }

  .citas {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-5);
    display: grid;
    gap: var(--space-6);
  }

  .cita--0 { --cita-c: var(--brand-red); }
  .cita--1 { --cita-c: var(--brand-blue); }
  .cita--2 { --cita-c: var(--brand-magenta); }

  .cita figure {
    margin: 0;
    padding-block-start: var(--space-3);
    border-block-start: var(--border-w-thick) solid var(--cita-c);
  }

  /* La comilla es una figura más del sistema: el mismo bloque de color
     que la raya, colgado a la izquierda del texto. */
  blockquote {
    position: relative;
    margin: 0;
    font-size: clamp(1.2rem, 0.95rem + 1vw, 1.75rem);
    line-height: 1.42;
    text-wrap: pretty;
  }

  blockquote::before {
    content: '“';
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 4em;
    line-height: 0.6;
    block-size: 0.38em;
    color: var(--cita-c);
  }

  blockquote :global(p) { max-width: 38em; }
  blockquote :global(p + p) { margin-block-start: 0.8em; }

  .cita__firma {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
  }

  .cita__firma img {
    flex: none;
    inline-size: 56px;
    block-size: 56px;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--cita-c);
    filter: grayscale(1);
  }

  .cita__firma > span { display: grid; }

  .cita__nombre {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .cita__proyecto {
    font-size: var(--step-xs);
    color: var(--cita-suave);
  }

  /* En ancho las citas se desplazan: la primera pegada a la izquierda,
     la siguiente empujada a la derecha. El zigzag es lo que las hace
     leerse como voces distintas y no como una lista. */
  @media (width >= 55rem) {
    .citas { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .cita { grid-column: 1 / span 9; }
    .cita:nth-child(even) { grid-column: 4 / -1; }
  }
</style>
