---
/**
 * HERO — Portada: fotografía del estudio de fondo, atenuada con una
 * viñeta, y el titular encima.
 *
 * Es una "isla oscura": el fondo es siempre la foto, así que aquí
 * dentro los papeles se invierten pase lo que pase con el tema de la
 * página. Por eso el bloque redefine los roles de color en lugar de
 * heredarlos — si no, en modo claro los bordes de los botones serían
 * casi negros sobre una foto casi negra.
 *
 * Todo lo editable (qué foto, cuánto se atenúa) vive en HERO, dentro
 * de src/config.ts.
 */
import { getImage } from 'astro:assets';
import { SITE, HERO, CREDITOS, waHref, mailHref } from '../config';
import { buscarFoto, type Foto } from '../lib/imagen';

const ancha = buscarFoto(HERO.imagen, 1800);
const alta = HERO.imagenMovil.trim() ? buscarFoto(HERO.imagenMovil, 1000) : null;

/* La portada lleva dirección de arte: un recorte vertical para el
   móvil y otro apaisado para el resto, así que no basta con un
   <Picture>, que solo sabe dar tamaños de UNA foto. Se piden a mano
   las versiones AVIF y WebP de cada recorte y se montan como <source>
   con su media query. Las fotos por enlace se usan tal cual. */
const MOVIL = '(max-width: 54.99rem)';

/** Figuras que separan los créditos, en el orden del logotipo */
const FIGURAS = ['cuadrado', 'circulo', 'triangulo'] as const;

async function fuentes(foto: Foto | null, anchos: number[], media?: string) {
  if (!foto) return [];
  if (foto.tipo === 'remota') return media ? [{ media, type: undefined, srcset: foto.url }] : [];

  const validos = anchos.filter((w) => w <= foto.imagen.width);
  const widths = validos.length ? validos : [foto.imagen.width];

  return Promise.all(
    (['avif', 'webp'] as const).map(async (format) => {
      const version = await getImage({ src: foto.imagen, widths, format });
      return { media, type: `image/${format}`, srcset: version.srcSet.attribute };
    })
  );
}

const fuentesMovil = await fuentes(alta, [640, 960, 1280], MOVIL);
const fuentesAncha = await fuentes(ancha, [1280, 1600, 1920]);

/* La <img> de respaldo: la apaisada en JPG, para el navegador que no
   entienda ni AVIF ni WebP. */
const respaldo =
  ancha?.tipo === 'local'
    ? (await getImage({ src: ancha.imagen, width: Math.min(1600, ancha.imagen.width), format: 'jpg' })).src
    : ancha?.url ?? '';
---

<section
  class:list={['hero', { 'hero--con-foto': ancha !== null }]}
  style={`--hero-encuadre: ${HERO.encuadre};
          --hero-oscurecer: ${HERO.oscurecer};
          --hero-vineta: ${HERO.vineta};
          --hero-saturacion: ${HERO.saturacion};`}
>
  {
    ancha !== null && (
      <div class="hero__fondo" aria-hidden="true">
        <picture>
          {fuentesMovil.map((f) => (
            <source media={f.media} type={f.type} srcset={f.srcset} sizes="100vw" />
          ))}
          {fuentesAncha.map((f) => (
            <source type={f.type} srcset={f.srcset} sizes="100vw" />
          ))}
          {/* fetchpriority alto: es la imagen más grande de la primera
              pantalla, así que es la que decide la nota de carga. */}
          <img src={respaldo} alt="" fetchpriority="high" decoding="async" />
        </picture>
        <div class="hero__velo"></div>
      </div>
    )
  }

  <div class="hero__grid wrap">
    <div class="hero__text">
      <p class="eyebrow">{SITE.role} · {SITE.city}</p>
      {/* Una línea por renglón, cada una dentro de su propia ventana
          recortada: así el texto sube desde debajo del renglón en vez
          de aparecer sin más. Los <br> ya fijaban estos tres cortes,
          así que la composición no cambia. */}
      <h1 class="hero__titular">
        <span class="hero__linea" style="--d: 110ms"><span>Tu canción</span></span>
        <span class="hero__linea" style="--d: 190ms"><span class="hl">merece</span></span>
        <span class="hero__linea" style="--d: 270ms"><span>sonar bien</span></span>
      </h1>
      <p class="lead">
        Asesorías, producciones y mezcla para artistas independientes.
        Proceso claro, fechas que se cumplen y un máster listo para
        subir el mismo día que lo apruebas.
      </p>
      <div class="hero__cta">
        <a class="btn" href={waHref} target="_blank" rel="noopener">WhatsApp</a>
        <a class="btn btn--ghost" href={mailHref}>Escribir correo</a>
      </div>
      <p class="hero__meta muted">
        Respuesta en menos de 48 h
      </p>

      {/* Créditos: la prueba social junto a la acción, dentro de la
          portada, en vez de una banda aparte que cortaba el paso del
          hero a Trabajos. */}
      {CREDITOS.length > 0 && (
        <div class="creditos">
          <p class="creditos__titulo" id="creditos-titulo">Han grabado conmigo</p>
          <ul class="creditos__lista" role="list" aria-labelledby="creditos-titulo">
            {CREDITOS.map((nombre, i) => (
              <li class="credito">
                <span class="credito__nombre">{nombre}</span>
                <i class:list={['figura', `figura--${FIGURAS[i % FIGURAS.length]}`]} aria-hidden="true" />
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3rem, 7vw, 7rem);
    overflow: hidden;
  }

  /* Con foto, el hero es una portada: tiene que caber en la primera
     pantalla o deja de serlo. Por eso aquí el titular se topa antes
     que en el resto del sitio y el aire de arriba y abajo se recorta. */
  .hero--con-foto { padding-block: clamp(2.5rem, 5vw, 4.5rem); }

  /* El tope en vw es lo que mantiene los tres renglones.
     La escala general (--step-4) no baja de 3.2rem, y a ese tamaño
     "Tu canción" pide unos 330px mientras que en un móvil de 375
     solo hay 319 de ancho útil: el renglón se partía en dos y el
     titular pasaba a cuatro líneas. Con 12vw el más largo entra de
     sobra hasta en pantallas de 320px. */
  .hero--con-foto h1 { font-size: min(var(--step-4), 5.5rem, 12vw); }

  /* ── Isla oscura ───────────────────────────────────────────────
     Con foto de fondo, el hero es oscuro en los dos temas. Los roles
     de color se reasignan aquí (no se heredan) porque un custom
     property ya viene resuelto de :root: redefinir --brand-red no
     cambiaría --color-accent, hay que tocar el rol directamente.   */
  .hero--con-foto {
    --brand-ink: var(--paper-fixed);
    --brand-paper: var(--ink-fixed);
    --brand-line: var(--paper-fixed);
    --color-fg: var(--paper-fixed);
    --color-muted: var(--ink-soft-fixed);
    --color-accent: var(--red-fixed);
    --color-accent-2: var(--blue-fixed);
    --color-accent-3: var(--magenta-fixed);
    --color-on-accent: var(--ink-fixed);
    --color-on-magenta: var(--ink-fixed);

    color: var(--color-fg);
    background: var(--ink-fixed);
    min-block-size: min(84svh, 44rem);
    display: grid;
    align-items: center;
  }

  /* ── Capas del fondo ───────────────────────────────────────────
     foto (z0) · viñeta (z1) · texto (z3)                          */
  .hero__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__fondo img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--hero-encuadre, center);
    /* Baja el color de la foto sin tocar su brillo: el velo ya se
       encarga de oscurecer, y bajar los dos a la vez la apaga. */
    filter: saturate(var(--hero-saturacion, 1));
  }

  /* La viñeta son tres capas: el oscurecido plano que baja el brillo
     general, un degradado desde abajo para que el texto tenga suelo,
     y la elipse que cierra las esquinas. */
  .hero__velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(
        ellipse 88% 74% at 50% 45%,
        transparent 0%,
        rgb(0 0 0 / calc(var(--hero-vineta, 0.9) * 0.42)) 52%,
        rgb(0 0 0 / var(--hero-vineta, 0.9)) 100%
      ),
      linear-gradient(to top, rgb(0 0 0 / 0.75), transparent 60%),
      rgb(0 0 0 / var(--hero-oscurecer, 0.5));
  }

  .hero__grid {
    position: relative;
    z-index: 3;
    display: grid;
    gap: var(--space-5);
  }

  .hero__text { max-inline-size: 42rem; }

  /* ── Titular por líneas ────────────────────────────────────────
     Cada renglón es una ventana con overflow oculto y el texto vive
     dentro. El padding de abajo, devuelto con margen negativo, es
     para que el recorte no muerda los rasgos que bajan de la línea
     base ni el fondo del resaltado: con interlínea 0.95 la caja va
     más justa que la letra.                                       */
  .hero__linea {
    display: block;
    overflow: hidden;
    padding-block-end: 0.09em;
    margin-block-end: -0.09em;
  }

  .hero__linea > span { display: inline-block; }

  @media (prefers-reduced-motion: no-preference) {
    /* `:global(.js)` y no `.js`: la clase vive en <html>, fuera de
       este componente, y Astro le añadiría su identificador de ámbito
       al selector — con lo que no encajaría con nada. */
    :global(.js) .hero__linea > span {
      /* El desplazamiento vive en el fotograma inicial, NO aquí, y se
         rellena con `backwards` en lugar de `forwards`. Escrito al
         revés —el titular bajado en la regla y subido por la
         animación— basta con que la animación no llegue a ejecutarse
         para que el titular de la página se quede fuera de su ventana
         recortada, es decir invisible. El reposo tiene que ser el
         estado legible. */
      animation: subir-linea 780ms cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0ms) backwards;
    }

    @keyframes subir-linea {
      from { translate: 0 115%; }
      to { translate: 0 0; }
    }

    /* ── El fader ────────────────────────────────────────────────
       El momento de la portada: cuando "merece" ya ha subido, su
       bloque magenta se rellena de izquierda a derecha, como un
       fader que sube hasta su nivel, y la palabra pasa de blanco a
       tinta en cuanto el color la cubre. Es el único movimiento de
       autor de la página; todo lo demás está quieto o responde al
       visitante. */
    :global(.js) .hero__linea > .hl {
      animation:
        subir-linea 780ms cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0ms) backwards,
        subir-fader 720ms cubic-bezier(0.65, 0, 0.35, 1) calc(var(--d, 0ms) + 560ms) backwards;
    }

    @keyframes subir-fader {
      from { background-size: 0% 100%; color: var(--color-fg); }
      60% { color: var(--color-fg); }
      to { background-size: 100% 100%; color: var(--color-on-magenta); }
    }

    /* Y si el script decide que el movimiento no funciona (ver la red
       de seguridad de revelar.ts), el titular deja de esperar. */
    :global(.sin-movimiento) .hero__linea > span { animation: none; }
  }

  /* El fondo es un degradado de un solo color y no un color plano
     para poder animar su ancho (background-size) sin tocar la caja. */
  .hl {
    background:
      linear-gradient(var(--color-accent-3), var(--color-accent-3))
      no-repeat 0 0 / 100% 100%;
    color: var(--color-on-magenta);
    padding-inline: 0.15em;
    box-decoration-break: clone;
  }

  .hero .lead { margin-block-start: var(--space-3); }

  /* Sobre una foto, el texto necesita despegarse del fondo aunque el
     velo ya lo haya oscurecido: la sombra evita que una zona clara de
     la imagen se coma una línea. */
  .hero--con-foto h1,
  .hero--con-foto .lead,
  .hero--con-foto .eyebrow,
  .hero--con-foto .hero__meta {
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.55);
  }

  .hero--con-foto .hl { text-shadow: none; }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
  }

  .hero__meta {
    margin-block-start: var(--space-3);
    font-size: var(--step-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* ── Créditos ──────────────────────────────────────────────────
     Un renglón al pie del texto de la portada: rótulo pequeño con una
     raya delante y los nombres en Clash, separados por las figuras
     del logotipo en sus tres colores. Separado del bloque de botones
     por más aire que el que hay entre botones y meta: es otro grupo. */
  .creditos { margin-block-start: var(--space-5); }

  .creditos__titulo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .creditos__titulo::before {
    content: '';
    inline-size: 2rem;
    block-size: 2px;
    background: currentColor;
  }

  .creditos__lista {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .credito {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .credito__nombre {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .figura {
    display: block;
    flex: none;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    transition: transform 450ms var(--ease-out);
  }

  .figura--cuadrado { background: var(--color-accent); }
  .figura--circulo { background: var(--color-accent-2); border-radius: 50%; }

  .figura--triangulo {
    inline-size: 0;
    block-size: 0;
    border-inline: 0.35rem solid transparent;
    border-block-end: 0.6rem solid var(--color-accent-3);
  }

  .credito:last-child .figura { display: none; }

  /* Con ratón, la figura que sigue al nombre gira un cuarto de vuelta */
  @media (hover: hover) {
    .credito:hover .figura { transform: rotate(90deg); }
  }

  .hero--con-foto .creditos { text-shadow: 0 2px 18px rgb(0 0 0 / 0.55); }

  @media (width >= 55rem) {
    .hero--con-foto { min-block-size: min(80svh, 46rem); }
    .hero__text { max-inline-size: 36rem; }
  }
</style>
