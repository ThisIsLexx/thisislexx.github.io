---
/**
 * HERO — Portada: fotografía del estudio de fondo, atenuada con una
 * viñeta, y una capa de partículas por encima que reacciona al
 * puntero.
 *
 * Es una "isla oscura": el fondo es siempre la foto, así que aquí
 * dentro los papeles se invierten pase lo que pase con el tema de la
 * página. Por eso el bloque redefine los roles de color en lugar de
 * heredarlos — si no, en modo claro los bordes de los botones serían
 * casi negros sobre una foto casi negra.
 *
 * Todo lo editable (qué foto, cuánto se atenúa, si hay partículas)
 * vive en HERO, dentro de src/config.ts.
 */
import { SITE, CONTACT, HERO, waHref, mailHref } from '../config';
import { resolverImagen } from '../lib/imagen';

const foto = resolverImagen(HERO.imagen, 1800);
const fotoMovil = resolverImagen(HERO.imagenMovil, 1000) || foto;
---

<section
  class:list={['hero', { 'hero--con-foto': foto !== '' }]}
  style={`--hero-encuadre: ${HERO.encuadre};
          --hero-oscurecer: ${HERO.oscurecer};
          --hero-vineta: ${HERO.vineta};
          --hero-saturacion: ${HERO.saturacion};`}
>
  {
    foto !== '' && (
      <div class="hero__fondo" aria-hidden="true">
        <picture>
          {fotoMovil !== foto && <source media="(max-width: 54.99rem)" srcset={fotoMovil} />}
          {/* fetchpriority alto: es la imagen más grande de la primera
              pantalla, así que es la que decide la nota de carga. */}
          <img src={foto} alt="" fetchpriority="high" decoding="async" />
        </picture>
        <div class="hero__velo"></div>
        {HERO.particulas && <canvas class="hero__particulas" data-particulas></canvas>}
      </div>
    )
  }

  <div class="hero__grid wrap">
    <div class="hero__text">
      <p class="eyebrow reveal" style="--retardo: 40ms">{SITE.role} · {SITE.city}</p>
      {/* Una línea por renglón, cada una dentro de su propia ventana
          recortada: así el texto sube desde debajo del renglón en vez
          de aparecer sin más. Los <br> ya fijaban estos tres cortes,
          así que la composición no cambia. */}
      <h1 class="hero__titular">
        <span class="hero__linea" style="--d: 110ms"><span>Tu canción</span></span>
        <span class="hero__linea" style="--d: 190ms"><span class="hl">merece</span></span>
        <span class="hero__linea" style="--d: 270ms"><span>sonar bien</span></span>
      </h1>
      <p class="lead reveal" style="--retardo: 430ms">
        Asesorías, producciones y mezcla para artistas independientes.
        Proceso claro, fechas que se cumplen y un máster listo para
        subir el mismo día que lo apruebas.
      </p>
      <div class="hero__cta reveal" style="--retardo: 500ms">
        <a class="btn" href={waHref} target="_blank" rel="noopener">WhatsApp</a>
        <a class="btn btn--ghost" href={mailHref}>Escribir correo</a>
      </div>
      <p class="hero__meta muted reveal" style="--retardo: 570ms">
        Respuesta en menos de 48 h · {CONTACT.email}
      </p>
    </div>
  </div>
</section>

<script>
  /**
   * PARTÍCULAS — Un campo de puntos que flota despacio sobre la foto
   * y se aparta del puntero. Sin librerías: son cuarenta puntos y una
   * resta de vectores, no hace falta traerse 30 kB para eso.
   *
   * Se detiene sola cuando el hero sale de pantalla o la pestaña pasa
   * a segundo plano: un rAF girando en una pestaña oculta es batería
   * de alguien.
   */
  const lienzo = document.querySelector<HTMLCanvasElement>('[data-particulas]');
  const hero = lienzo?.closest<HTMLElement>('.hero');

  if (lienzo && hero) {
    const ctx = lienzo.getContext('2d')!;
    const quieto = matchMedia('(prefers-reduced-motion: reduce)');

    /** Figuras por píxel de superficie. Subirlo llena más el campo. */
    const DENSIDAD = 1 / 38000;
    const MAX = 46;
    /** Radio de la figura, en píxeles CSS: de la más chica a la más grande */
    const TAM = [2.5, 8];
    /** Opacidad de las figuras. Es un fondo: si se lee, estorba. */
    const ALFA = 0.1;
    /** Radio de influencia del puntero, en píxeles CSS */
    const ALCANCE = 150;
    /** Distancia a la que dos figuras se unen con un hilo */
    const HILO = 110;
    /** Su cuadrado, para comparar distancias sin sacar raíces */
    const HILO_2 = HILO * HILO;

    /** Cuadros por segundo del campo. Es un fondo que se arrastra a
        0.22 px por cuadro: a 30 se ve igual que a 60 y cuesta la mitad
        de hilo principal, que es el que también atiende al scroll. */
    const FPS = 30;
    const MS_CUADRO = 1000 / FPS;

    /** El vocabulario de formas del sitio, el mismo de Shape.astro */
    const FIGURAS = ['circulo', 'medio', 'cuarto', 'triangulo', 'cuadrado'] as const;
    type Figura = (typeof FIGURAS)[number];

    let w = 0;
    let h = 0;
    let dpr = 1;
    let puntos: {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
      figura: Figura;
      giro: number;
      vgiro: number;
      relleno: boolean;
    }[] = [];
    let raf = 0;
    let visible = true;

    // El puntero vive fuera del lienzo hasta que entra de verdad: así
    // el campo arranca en reposo y no con un agujero en la esquina.
    const raton = { x: -9999, y: -9999 };

    /** Todas blancas. El canvas no entiende var(), hay que resolverlo. */
    const blanco =
      getComputedStyle(document.documentElement).getPropertyValue('--paper-fixed').trim() ||
      '#f2efe6';

    function sembrar() {
      const cuantos = Math.min(MAX, Math.round(w * h * DENSIDAD));
      puntos = Array.from({ length: cuantos }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        // Velocidades pequeñas: esto tiene que notarse solo si te paras a mirar
        vx: (Math.random() - 0.5) * 0.22,
        vy: (Math.random() - 0.5) * 0.22,
        r: TAM[0] + Math.random() * (TAM[1] - TAM[0]),
        figura: FIGURAS[Math.floor(Math.random() * FIGURAS.length)],
        giro: Math.random() * Math.PI * 2,
        // Media vuelta cada minuto largo: gira, pero no se ve girar
        vgiro: (Math.random() - 0.5) * 0.0022,
        // Una de cada tres va a línea, como las figuras del resto del sitio
        relleno: Math.random() > 0.34,
      }));
    }

    function medir() {
      const caja = hero!.getBoundingClientRect();
      // Tope de seguridad: si algún día el CSS del lienzo no llega a
      // aplicarse, el canvas pasa a ocupar sitio en el flujo, estira
      // el hero, el ResizeObserver vuelve a medir y el bucle se come
      // el navegador. Con el tope, como mucho sale feo.
      w = Math.min(caja.width, 4000);
      h = Math.min(caja.height, 4000);
      // Cap a 2: en un móvil con dpr 3 el lienzo pasa de 6 millones de
      // píxeles y el ventilador se entera.
      dpr = Math.min(devicePixelRatio || 1, 2);
      lienzo!.width = Math.round(w * dpr);
      lienzo!.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      sembrar();
    }

    /** Traza la figura centrada en (0,0); el giro y la posición ya
        vienen puestos en la matriz del contexto. */
    function trazar(figura: Figura, r: number) {
      ctx.beginPath();
      switch (figura) {
        case 'circulo':
          ctx.arc(0, 0, r, 0, Math.PI * 2);
          break;
        case 'medio':
          ctx.arc(0, 0, r, 0, Math.PI);
          ctx.closePath();
          break;
        case 'cuarto':
          // El cuarto de círculo del logotipo: dos radios y el arco
          ctx.moveTo(0, 0);
          ctx.arc(0, 0, r, 0, Math.PI / 2);
          ctx.closePath();
          break;
        case 'triangulo': {
          // Equilátero apoyado en su centro
          const a = (Math.PI * 2) / 3;
          ctx.moveTo(0, -r);
          ctx.lineTo(r * Math.sin(a), -r * Math.cos(a));
          ctx.lineTo(r * Math.sin(2 * a), -r * Math.cos(2 * a));
          ctx.closePath();
          break;
        }
        case 'cuadrado':
          ctx.rect(-r * 0.8, -r * 0.8, r * 1.6, r * 1.6);
          break;
      }
    }

    function pintar() {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = blanco;
      ctx.strokeStyle = blanco;

      // Hilos entre figuras cercanas. Van primero, para quedar debajo.
      //
      // Esto compara todas las figuras contra todas, así que es lo más
      // caro del cuadro. Dos atajos, porque se ejecuta constantemente:
      // se descartan los pares lejanos mirando un solo eje —que es la
      // mayoría de ellos— y se compara la distancia AL CUADRADO. La
      // raíz solo se calcula para los pares que de verdad se unen, que
      // son un puñado.
      ctx.lineWidth = 1;
      for (let i = 0; i < puntos.length; i++) {
        const a = puntos[i];
        for (let j = i + 1; j < puntos.length; j++) {
          const b = puntos[j];

          const dx = a.x - b.x;
          if (dx > HILO || dx < -HILO) continue;
          const dy = a.y - b.y;
          if (dy > HILO || dy < -HILO) continue;

          const d2 = dx * dx + dy * dy;
          if (d2 > HILO_2) continue;

          ctx.globalAlpha = (1 - Math.sqrt(d2) / HILO) * ALFA * 0.4;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }

      ctx.lineWidth = 1;
      for (const p of puntos) {
        ctx.globalAlpha = ALFA;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.giro);
        trazar(p.figura, p.r);
        p.relleno ? ctx.fill() : ctx.stroke();
        ctx.restore();
      }
      ctx.globalAlpha = 1;
    }

    /** @param paso Cuánto avanzar, en cuadros de 60 Hz equivalentes */
    function mover(paso) {
      for (const p of puntos) {
        p.x += p.vx * paso;
        p.y += p.vy * paso;
        p.giro += p.vgiro * paso;

        // Rebote en los bordes: el campo no se vacía nunca
        if (p.x < 0 || p.x > w) p.vx *= -1;
        if (p.y < 0 || p.y > h) p.vy *= -1;

        // Empuje del puntero: cuanto más cerca, más se aparta.
        // Se descarta por ejes antes de la raíz: con el ratón quieto en
        // una esquina, casi ninguna figura está a tiro.
        const dx = p.x - raton.x;
        const dy = p.y - raton.y;
        if (dx < ALCANCE && dx > -ALCANCE && dy < ALCANCE && dy > -ALCANCE) {
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < ALCANCE && d > 0.01) {
            const fuerza = (1 - d / ALCANCE) * 0.9 * paso;
            p.x += (dx / d) * fuerza;
            p.y += (dy / d) * fuerza;
          }
        }

        // Un punto empujado fuera se recoloca dentro
        p.x = Math.max(0, Math.min(w, p.x));
        p.y = Math.max(0, Math.min(h, p.y));
      }
    }

    let ultimo = 0;

    function bucle(t) {
      raf = requestAnimationFrame(bucle);

      const dt = t - ultimo;
      if (dt < MS_CUADRO) return; // aún no toca cuadro
      ultimo = t;

      // El avance va por tiempo y no por cuadro: así el campo se
      // arrastra a la misma velocidad en una pantalla de 60 Hz y en
      // una de 120. El tope de 3 evita el salto al volver de una
      // pestaña en segundo plano, donde dt puede ser de segundos.
      mover(Math.min(dt / 16.667, 3));
      pintar();
    }

    function arrancar() {
      if (raf || !visible || quieto.matches) return;
      ultimo = performance.now();
      raf = requestAnimationFrame(bucle);
    }

    function parar() {
      cancelAnimationFrame(raf);
      raf = 0;
    }

    // Con "menos movimiento" activado el campo se pinta una vez y se
    // queda quieto: la textura sigue ahí, el movimiento no.
    medir();
    if (quieto.matches) pintar();
    else arrancar();

    new ResizeObserver(() => {
      medir();
      if (quieto.matches || !raf) pintar();
    }).observe(hero);

    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        visible ? arrancar() : parar();
      },
      { threshold: 0 }
    ).observe(hero);

    document.addEventListener('visibilitychange', () =>
      document.hidden ? parar() : arrancar()
    );

    // El lienzo no recibe eventos (pointer-events: none) para no
    // taparle los clics a los botones, así que escuchamos en el hero.
    hero.addEventListener('pointermove', (e) => {
      const caja = hero.getBoundingClientRect();
      raton.x = e.clientX - caja.left;
      raton.y = e.clientY - caja.top;
    });
    hero.addEventListener('pointerleave', () => {
      raton.x = -9999;
      raton.y = -9999;
    });

    quieto.addEventListener('change', () => {
      parar();
      if (quieto.matches) pintar();
      else arrancar();
    });
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3rem, 7vw, 7rem);
    overflow: hidden;
  }

  /* Con foto, el hero es una portada: tiene que caber en la primera
     pantalla o deja de serlo. Por eso aquí el titular se topa antes
     que en el resto del sitio y el aire de arriba y abajo se recorta. */
  .hero--con-foto { padding-block: clamp(2.5rem, 5vw, 4.5rem); }

  /* El tope en vw es lo que mantiene los tres renglones.
     La escala general (--step-4) no baja de 3.2rem, y a ese tamaño
     "Tu canción" pide unos 330px mientras que en un móvil de 375
     solo hay 319 de ancho útil: el renglón se partía en dos y el
     titular pasaba a cuatro líneas. Con 12vw el más largo entra de
     sobra hasta en pantallas de 320px. */
  .hero--con-foto h1 { font-size: min(var(--step-4), 5.5rem, 12vw); }

  /* ── Isla oscura ───────────────────────────────────────────────
     Con foto de fondo, el hero es oscuro en los dos temas. Los roles
     de color se reasignan aquí (no se heredan) porque un custom
     property ya viene resuelto de :root: redefinir --brand-red no
     cambiaría --color-accent, hay que tocar el rol directamente.   */
  .hero--con-foto {
    --brand-ink: var(--paper-fixed);
    --brand-paper: var(--ink-fixed);
    --brand-line: var(--paper-fixed);
    --color-fg: var(--paper-fixed);
    --color-muted: var(--ink-soft-fixed);
    --color-accent: var(--red-fixed);
    --color-accent-2: var(--blue-fixed);
    --color-accent-3: var(--magenta-fixed);
    --color-on-accent: var(--ink-fixed);
    --color-on-magenta: var(--ink-fixed);

    color: var(--color-fg);
    background: var(--ink-fixed);
    min-block-size: min(84svh, 44rem);
    display: grid;
    align-items: center;
    border-block-end: var(--border-w-thick) solid var(--brand-line);
  }

  /* ── Capas del fondo ───────────────────────────────────────────
     foto (z0) · viñeta (z1) · partículas (z2) · texto (z3)        */
  .hero__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__fondo img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--hero-encuadre, center);
    /* Baja el color de la foto sin tocar su brillo: el velo ya se
       encarga de oscurecer, y bajar los dos a la vez la apaga. */
    filter: saturate(var(--hero-saturacion, 1));
  }

  /* La viñeta son tres capas: el oscurecido plano que baja el brillo
     general, un degradado desde abajo para que el texto tenga suelo,
     y la elipse que cierra las esquinas. */
  .hero__velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(
        ellipse 88% 74% at 50% 45%,
        transparent 0%,
        rgb(0 0 0 / calc(var(--hero-vineta, 0.9) * 0.42)) 52%,
        rgb(0 0 0 / var(--hero-vineta, 0.9)) 100%
      ),
      linear-gradient(to top, rgb(0 0 0 / 0.75), transparent 60%),
      rgb(0 0 0 / var(--hero-oscurecer, 0.5));
  }

  .hero__particulas {
    position: absolute;
    inset: 0;
    z-index: 2;
    inline-size: 100%;
    block-size: 100%;
    /* Que los clics lleguen a los botones */
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 3;
    display: grid;
    gap: var(--space-5);
  }

  .hero__text { max-inline-size: 42rem; }

  /* ── Titular por líneas ────────────────────────────────────────
     Cada renglón es una ventana con overflow oculto y el texto vive
     dentro. El padding de abajo, devuelto con margen negativo, es
     para que el recorte no muerda los rasgos que bajan de la línea
     base ni el fondo del resaltado: con interlínea 0.95 la caja va
     más justa que la letra.                                       */
  .hero__linea {
    display: block;
    overflow: hidden;
    padding-block-end: 0.09em;
    margin-block-end: -0.09em;
  }

  .hero__linea > span { display: inline-block; }

  @media (prefers-reduced-motion: no-preference) {
    /* `:global(.js)` y no `.js`: la clase vive en <html>, fuera de
       este componente, y Astro le añadiría su identificador de ámbito
       al selector — con lo que no encajaría con nada. */
    :global(.js) .hero__linea > span {
      /* El desplazamiento vive en el fotograma inicial, NO aquí, y se
         rellena con `backwards` en lugar de `forwards`. Escrito al
         revés —el titular bajado en la regla y subido por la
         animación— basta con que la animación no llegue a ejecutarse
         para que el titular de la página se quede fuera de su ventana
         recortada, es decir invisible. El reposo tiene que ser el
         estado legible. */
      animation: subir-linea 780ms cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0ms) backwards;
    }

    @keyframes subir-linea {
      from { translate: 0 115%; }
      to { translate: 0 0; }
    }

    /* Y si el script decide que el movimiento no funciona (ver la red
       de seguridad de revelar.ts), el titular deja de esperar. */
    :global(.sin-movimiento) .hero__linea > span { animation: none; }
  }

  .hl {
    background: var(--color-accent-3);
    color: var(--color-on-magenta);
    padding-inline: 0.15em;
    box-decoration-break: clone;
  }

  .hero .lead { margin-block-start: var(--space-3); }

  /* Sobre una foto, el texto necesita despegarse del fondo aunque el
     velo ya lo haya oscurecido: la sombra evita que una zona clara de
     la imagen se coma una línea. */
  .hero--con-foto h1,
  .hero--con-foto .lead,
  .hero--con-foto .eyebrow,
  .hero--con-foto .hero__meta {
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.55);
  }

  .hero--con-foto .hl { text-shadow: none; }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
  }

  .hero__meta {
    margin-block-start: var(--space-3);
    font-size: var(--step-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    /* El correo es largo y no se puede partir por cualquier sitio */
    overflow-wrap: anywhere;
  }

  @media (width >= 55rem) {
    .hero--con-foto { min-block-size: min(80svh, 46rem); }
    .hero__text { max-inline-size: 36rem; }
  }
</style>
