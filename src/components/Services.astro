---
/**
 * SERVICIOS — Una carta de precios, no cuatro tarjetas iguales.
 *
 * El primer servicio (el de menor `orden`, hoy "La combi completa")
 * es el destacado: un bloque grande en su color, con todo lo que
 * incluye y el precio a tamaño de titular. El resto va al lado como
 * una lista de precios, una fila por servicio. Así la página dice
 * cuál es la apuesta y deja comparar el resto de un vistazo.
 *
 * Un archivo en src/content/servicios/ = un servicio.
 */
import { getCollection } from 'astro:content';
import { waHref } from '../config';
import Shape from './Shape.astro';

const servicios = (await getCollection('servicios')).sort(
  (a, b) => a.data.orden - b.data.orden
);

const [destacado, ...resto] = servicios;
---

<section class="section" id="servicios">
  <div class="wrap">
    <header class="cabecera">
      <h2 class="reveal">Lo que hago</h2>
      <p class="lead muted">
        Puedes contratar servicios individuales o el paquete completo.
        Los precios son de referencia por canción, pero estos pueden variar; el presupuesto final
        depende del alcance.
      </p>
    </header>

    <div class="carta">
      {destacado && (
        <article class:list={['destacado', `destacado--${destacado.data.color}`]}>
          <Shape
            tipo={destacado.data.figura}
            color={destacado.data.color === 'ink' ? 'paper' : 'ink'}
            size="clamp(3rem, 6vw, 4.5rem)"
          />
          <h3>{destacado.data.titulo}</h3>
          <p class="destacado__resumen">{destacado.data.resumen}</p>

          <ul class="destacado__incluye" role="list">
            {destacado.data.incluye.map((f) => <li>{f}</li>)}
          </ul>

          <div class="destacado__pie">
            {destacado.data.desde && (
              <p class="precio">
                <span class="precio__desde">Desde</span>
                <span class="precio__cifra">{destacado.data.desde}</span>
              </p>
            )}
            {destacado.data.entrega && <p class="entrega">Entrega {destacado.data.entrega}</p>}
          </div>
        </article>
      )}

      <ul class="lista" role="list">
        {resto.map((s) => (
          <li class="fila">
            <Shape tipo={s.data.figura} color={s.data.color} size="1.75rem" class="fila__figura" />

            <div class="fila__texto">
              <h3>{s.data.titulo}</h3>
              <p class="fila__resumen">{s.data.resumen}</p>
              <p class="fila__incluye">{s.data.incluye.join(' · ')}</p>
            </div>

            <div class="fila__precio">
              {s.data.desde && (
                <p class="precio">
                  <span class="precio__desde">Desde</span>
                  <span class="precio__cifra">{s.data.desde}</span>
                </p>
              )}
              {s.data.entrega && <p class="entrega">Entrega {s.data.entrega}</p>}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <a class="btn btn--magenta" href={waHref} target="_blank" rel="noopener">
      Pedir cotización
    </a>
  </div>
</section>

<style>
  /* En ancho, el titular y la entradilla van lado a lado y apoyados en
     la misma línea base: la entradilla deja de ser un párrafo suelto
     entre el titular y la carta, y la sección gana una fila. */
  @media (width >= 60rem) {
    .cabecera {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: end;
      gap: var(--space-5);
    }

    .cabecera .lead { margin: 0; justify-self: end; max-inline-size: 40ch; }
  }

  .carta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    margin-block: var(--space-5);
  }

  /* ── El destacado ──────────────────────────────────────────────── */
  .destacado {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--d-bg);
    color: var(--d-fg);
    border: var(--border-w) solid var(--brand-ink);
    box-shadow: var(--shadow-hard);
  }

  .destacado--red { --d-bg: var(--brand-red); --d-fg: var(--color-on-accent); }
  .destacado--blue { --d-bg: var(--brand-blue); --d-fg: var(--color-on-accent); }
  .destacado--magenta { --d-bg: var(--brand-magenta); --d-fg: var(--color-on-magenta); }
  .destacado--ink { --d-bg: var(--brand-ink); --d-fg: var(--brand-paper); }

  .destacado h3 {
    margin-block-start: var(--space-2);
    font-size: min(var(--step-3), 3.4rem, 11vw);
    font-weight: 700;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .destacado__resumen { font-size: var(--step-1); line-height: 1.35; }

  .destacado__incluye {
    margin: 0;
    padding: var(--space-3) 0 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
    border-block-start: var(--border-w) solid currentColor;
  }

  .destacado__incluye li { display: flex; gap: 0.6em; align-items: baseline; }
  .destacado__incluye li::before { content: '—'; flex: none; }

  .destacado__pie {
    margin-block-start: auto;
    padding-block-start: var(--space-3);
  }

  .destacado .precio__cifra { font-size: var(--step-2); }

  /* ── La lista ──────────────────────────────────────────────────── */
  .lista {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-end: var(--border-w) solid var(--brand-ink);
  }

  .fila {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-4);
    border-block-start: var(--border-w) solid var(--brand-ink);
  }

  .fila :global(.fila__figura) {
    margin-block-start: 0.15rem;
    transition: transform 450ms var(--ease-out);
  }

  @media (hover: hover) {
    .fila:hover :global(.fila__figura) { transform: rotate(90deg); }
  }

  .fila h3 { font-size: var(--step-card); }

  .fila__resumen {
    margin-block-start: var(--space-1);
    color: var(--color-muted);
  }

  /* Lo que incluye, como un párrafo corrido separado por puntos: en
     la lista basta para comparar. */
  .fila__incluye {
    margin-block-start: var(--space-2);
    font-size: var(--step-sm);
  }

  .fila__precio { grid-column: 2; }

  /* ── Precio y entrega, compartidos ─────────────────────────────── */
  .precio { display: grid; gap: 0.1em; }

  .precio__desde,
  .entrega {
    font-size: var(--step-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .precio__cifra {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }

  .entrega { margin-block-start: var(--space-1); opacity: 0.8; }

  @media (width >= 42rem) {
    .fila { grid-template-columns: auto minmax(0, 1fr) auto; }
    .fila__precio { grid-column: auto; text-align: end; }
  }

  @media (width >= 64rem) {
    .carta {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: var(--space-6);
    }
  }
</style>
