---
import { getCollection } from 'astro:content';
import { waHref } from '../config';
import Shape from './Shape.astro';

const servicios = (await getCollection('servicios')).sort(
  (a, b) => a.data.orden - b.data.orden
);

interface Props {
  /** Número de sección; lo calcula index.astro según cuáles se pintan */
  n?: string;
}

const { n = '02' } = Astro.props;
---

<section class="section" id="servicios">
  <div class="wrap">
    <p class="eyebrow">{n} / Servicios</p>
    <h2>Lo que hago</h2>
    <p class="lead muted">
      Puedes contratar una etapa suelta o el paquete completo.
      Los precios son de referencia por canción; el presupuesto final
      depende del alcance.
    </p>

    <ul class="grid" role="list">
      {
        servicios.map((s) => (
          <li class:list={['card', `card--${s.data.color}`, 'reveal']} data-foco>
            <Shape tipo={s.data.figura} color={s.data.color === 'ink' ? 'paper' : 'ink'} size="2.5rem" />
            <h3>{s.data.titulo}</h3>
            <p class="card__desc">{s.data.resumen}</p>

            <ul class="feats" role="list">
              {s.data.incluye.map((f) => <li>{f}</li>)}
            </ul>

            <div class="card__foot">
              {s.data.desde && <p class="price">Desde <b>{s.data.desde}</b></p>}
              {s.data.entrega && <p class="eta">Entrega {s.data.entrega}</p>}
            </div>
          </li>
        ))
      }
    </ul>

    <a class="btn btn--magenta" href={waHref} target="_blank" rel="noopener">
      Pedir cotización
    </a>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-cards);
    margin-block: var(--space-5) var(--space-6);
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-3);
    border: var(--border-w) solid var(--brand-ink);
    background: var(--card-bg, transparent);
    color: var(--card-fg, inherit);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .card :global(.shape) {
    transition: transform 450ms cubic-bezier(0.34, 1.3, 0.64, 1);
  }

  /* Solo en dispositivos con puntero real: en táctil el :hover se
     queda pegado después de tocar. */
  /* Efectos de realce. Se encienden con el ratón y, en pantallas sin
     ratón, con la clase .en-foco que pone el scroll (src/scripts/foco.ts):
     lo que pasa por el centro de la pantalla es lo que está vivo. */
  .card:is(:hover, .en-foco) {
    transform: translate(-5px, -5px);
    box-shadow: var(--shadow-hard);
    z-index: 1;
  }

  .card:is(:hover, .en-foco) :global(.shape) { transform: rotate(90deg) scale(1.15); }

  .card--red { --card-bg: var(--brand-red); --card-fg: var(--color-on-accent); }
  .card--blue { --card-bg: var(--brand-blue); --card-fg: var(--color-on-accent); }
  .card--magenta { --card-bg: var(--brand-magenta); --card-fg: var(--color-on-magenta); }
  .card--ink { --card-bg: var(--brand-ink); --card-fg: var(--brand-paper); }

  .card h3 { margin-block-start: var(--space-2); font-size: var(--step-card); }
  .card__desc { font-size: var(--step-sm); opacity: 0.92; }

  .feats {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    font-size: var(--step-sm);
    border-block-start: var(--border-w) solid currentColor;
    padding-block-start: var(--space-2);
  }

  .feats li { display: flex; gap: 0.6em; align-items: baseline; }
  .feats li::before { content: '—'; flex: none; opacity: 0.7; }

  .card__foot {
    margin-block-start: auto;
    padding-block-start: var(--space-3);
    font-size: var(--step-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .price b { font-family: var(--font-display); font-size: var(--step-sm); }
  .eta { opacity: 0.8; }

  @media (width >= 42rem) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (width >= 68rem) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
